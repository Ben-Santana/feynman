ANTHROPIC_API_KEY=
# Required only when your API key is not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=
# Grading, replies, rubrics and puzzles. Only Claude Opus models are accepted.
ANTHROPIC_MODEL=claude-opus-5-5
# Cheaper model for short, validated tasks (study steps, concept names, puzzle skill choice).
# Leave unset for claude-haiku-5-5; set to an empty value to use ANTHROPIC_MODEL for everything.
ANTHROPIC_LIGHT_MODEL=claude-haiku-5-5
PORT=3001
# Hosted custom-domain origin, e.g. https://feynman.example.com.
# Vercel preview and production deployment origins are allowed automatically.
APP_ORIGIN=

# Supabase accounts (email/password now; WPI SSO later). Authentication mode is
# controlled by public.account_auth_settings in the database. Use the same project as the frontend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Backend only: required for account administration. Never use a VITE_ prefix.
SUPABASE_SECRET_KEY=

# Landing page contact form: messages appear in the inbox of the approved admin with this email.
# Defaults to basantana@wpi.edu. Server-side only; never shown to visitors.
CONTACT_INBOX_EMAIL=
