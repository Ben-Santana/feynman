ANTHROPIC_API_KEY=
# Required only when your API key is not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-4-6
PORT=3001
# Hosted custom-domain origin, e.g. https://feynman.example.com.
# Vercel preview and production deployment origins are allowed automatically.
APP_ORIGIN=

# Supabase accounts (email/password now; WPI SSO later). Authentication mode is
# controlled by public.account_auth_settings in the database. Use the same project as the frontend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Backend only: required for account administration. Never use a VITE_ prefix.
SUPABASE_SECRET_KEY=
