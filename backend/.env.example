ANTHROPIC_API_KEY=
# Required only when your API key is not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-4-6
PORT=3001
# Hosted custom-domain origin, e.g. https://feynman.example.com.
# Vercel preview and production deployment origins are allowed automatically.
APP_ORIGIN=

# Optional: override the temporary signing secret; changing it revokes access cookies.
ACCESS_SESSION_SECRET=
